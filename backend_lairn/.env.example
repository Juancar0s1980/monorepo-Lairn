SECRET_KEY=cambia-esto-por-una-clave-secreta-segura
DEBUG=True
ALLOWED_HOSTS=*

DB_NAME=lairn_db
DB_USER=postgres
DB_PASSWORD=tu-password-aqui
DB_HOST=db
DB_PORT=5432

# Proveedor de IA generativa: "openai", "grok" o "groq". Cambiar de
# proveedor no requiere tocar codigo, solo esta variable y la key
# correspondiente. Ojo: "grok" (xAI) y "groq" (Groq Cloud) son proveedores
# distintos pese al nombre parecido.
AI_PROVIDER=openai

OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...
GROQ_API_KEY=gsk_...

# Microservicio ML (Knowledge Tracing). Vacio = desactivado (usa heuristico).
ML_SERVICE_URL=http://ml:8001
