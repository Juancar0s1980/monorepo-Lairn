SECRET_KEY=cambia-esto-por-una-clave-secreta-segura

# DEBUG=True es solo para desarrollo local: expone trazas de error completas
# (rutas de archivos, queries SQL, variables internas) a cualquiera. En un
# despliegue real SIEMPRE debe ser False — y al ponerlo en False,
# settings.py activa automaticamente SECURE_SSL_REDIRECT, cookies seguras y
# HSTS (ver el bloque "if not DEBUG" en settings.py), asi que no hace falta
# configurar nada mas a mano para esa parte.
DEBUG=True

# En local, "*" (cualquier host) esta bien. En produccion, la lista real de
# dominios separados por coma — por ejemplo:
#   ALLOWED_HOSTS=midominio.com,www.midominio.com
# (los espacios despues de la coma no importan, se recortan solos).
ALLOWED_HOSTS=*

DB_NAME=lairn_db
DB_USER=postgres
DB_PASSWORD=tu-password-aqui
DB_HOST=db
DB_PORT=5432

# Proveedor de IA generativa: "openai", "grok" o "groq". Cambiar de
# proveedor no requiere tocar codigo, solo esta variable y la key
# correspondiente. Ojo: "grok" (xAI) y "groq" (Groq Cloud) son proveedores
# distintos pese al nombre parecido.
AI_PROVIDER=openai

OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...
GROQ_API_KEY=gsk_...

# Microservicio ML (Knowledge Tracing). Vacio = desactivado (usa heuristico).
ML_SERVICE_URL=http://ml:8001
